MODULE mozhaiskiy
TIMESCALE 1

SCOPE donor (0, 0)

    PROCESS donor
        TIMESCALE 1
        CUSTOM_PROCESS([T0_plasmid_molecule], [T0_protein_molecule, T0_plasmid_molecule])
        CUSTOM_PROCESS([T0_plasmid_molecule, T2_protein_molecule], [T0_protein_molecule, T0_plasmid_molecule])
        CUSTOM_PROCESS([T0_plasmid_molecule, T5_protein_molecule], [T0_protein_molecule, T0_plasmid_molecule])
        CUSTOM_PROCESS([T0_protein_molecule], [T0_mod_protein_molecule])

        CUSTOM_PROCESS([T1_plasmid_molecule], [T1_protein_molecule, T1_plasmid_molecule])
        CUSTOM_PROCESS([T1_plasmid_molecule, T3_protein_molecule], [T1_protein_molecule, T1_plasmid_molecule])
        CUSTOM_PROCESS([T1_protein_molecule], [T1_mod_protein_molecule])

        CUSTOM_PROCESS([T2_plasmid_molecule, T1_protein_molecule], [T2_protein_molecule, T2_plasmid_molecule])
        CUSTOM_PROCESS([T2_plasmid_molecule, S1_molecule], [T2_protein_molecule, T2_plasmid_molecule])
        CUSTOM_PROCESS([T2_protein_molecule], [T2_mod_protein_molecule], INDUCERS: S1_molecule)

        CUSTOM_PROCESS([T3_plasmid_molecule, S1_molecule], [T3_protein_molecule, T3_plasmid_molecule])
        CUSTOM_PROCESS([T3_protein_molecule], [T3_mod_protein_molecule], INDUCERS: S2_molecule)

        CUSTOM_PROCESS([T4_plasmid_molecule, S1_molecule], [T4_protein_molecule, T4_plasmid_molecule])

        CUSTOM_PROCESS([T5_plasmid_molecule, S2_molecule], [T5_protein_molecule, T5_plasmid_molecule], INHIBITORS: T4_protein_molecule, T6_protein_molecule)
        CUSTOM_PROCESS([T5_protein_molecule], [T5_mod_protein_molecule])

        CUSTOM_PROCESS([T6_plasmid_molecule, S1_molecule], [T6_protein_molecule, T6_plasmid_molecule])

        CUSTOM_PROCESS([pilus_molecule], [2*pilus_molecule])

        CUSTOM_PROCESS([T4_plasmid_molecule, 20*pilus_molecule], [T4_plasmid_strand_molecule, T4_plasmid_molecule])
        CUSTOM_PROCESS([T5_plasmid_molecule, 20*pilus_molecule], [T5_plasmid_strand_molecule, T5_plasmid_molecule])
        CUSTOM_PROCESS([T6_plasmid_molecule, 20*pilus_molecule], [T6_plasmid_strand_molecule, T6_plasmid_molecule])

        DEGRADATION(T0_protein_molecule)
        DEGRADATION(T1_protein_molecule)
        DEGRADATION(T2_protein_molecule)
        DEGRADATION(T3_protein_molecule)
        DEGRADATION(T4_protein_molecule)
        DEGRADATION(T5_protein_molecule)
        DEGRADATION(T6_protein_molecule)
        DEGRADATION(T0_mod_protein_molecule)
        DEGRADATION(T1_mod_protein_molecule)
        DEGRADATION(T2_mod_protein_molecule)
        DEGRADATION(T3_mod_protein_molecule)
        DEGRADATION(T4_mod_protein_molecule)
        DEGRADATION(T5_mod_protein_molecule)
        DEGRADATION(T6_mod_protein_molecule)
        DEGRADATION(S1_molecule)
        DEGRADATION(S2_molecule)
        DEGRADATION(pilus_molecule)
        DEGRADATION(T4_plasmid_strand_molecule)
        DEGRADATION(T5_plasmid_strand_molecule)
        DEGRADATION(T6_plasmid_strand_molecule)

        JUXTACRINE_SIGNAL T4_plasmid_strand_molecule -> recipient
        JUXTACRINE_SIGNAL T5_plasmid_strand_molecule -> recipient
        JUXTACRINE_SIGNAL T6_plasmid_strand_molecule -> recipient


SCOPE recipient (0, 1)

    PROCESS recipient
        TIMESCALE 1
        CUSTOM_PROCESS([T0_plasmid_molecule], [T0_protein_molecule, T0_plasmid_molecule])
        CUSTOM_PROCESS([T0_plasmid_molecule, T2_protein_molecule], [T0_protein_molecule, T0_plasmid_molecule])
        CUSTOM_PROCESS([T0_plasmid_molecule, T5_protein_molecule], [T0_protein_molecule, T0_plasmid_molecule])
        CUSTOM_PROCESS([T0_protein_molecule], [T0_mod_protein_molecule])

        CUSTOM_PROCESS([T1_plasmid_molecule], [T1_protein_molecule, T1_plasmid_molecule])
        CUSTOM_PROCESS([T1_plasmid_molecule, T3_protein_molecule], [T1_protein_molecule, T1_plasmid_molecule])
        CUSTOM_PROCESS([T1_protein_molecule], [T1_mod_protein_molecule])

        CUSTOM_PROCESS([T2_plasmid_molecule, T1_protein_molecule], [T2_protein_molecule, T2_plasmid_molecule])
        CUSTOM_PROCESS([T2_plasmid_molecule, S1_molecule], [T2_protein_molecule, T2_plasmid_molecule])
        CUSTOM_PROCESS([T2_protein_molecule], [T2_mod_protein_molecule], INDUCERS: S1_molecule)

        CUSTOM_PROCESS([T3_plasmid_molecule, S1_molecule], [T3_protein_molecule, T3_plasmid_molecule])
        CUSTOM_PROCESS([T3_protein_molecule], [T3_mod_protein_molecule], INDUCERS: S2_molecule)

        CUSTOM_PROCESS([T4_plasmid_molecule, S1_molecule], [T4_protein_molecule, T4_plasmid_molecule])

        CUSTOM_PROCESS([T5_plasmid_molecule, S2_molecule], [T5_protein_molecule, T5_plasmid_molecule], INHIBITORS: T4_protein_molecule, T6_protein_molecule)
        CUSTOM_PROCESS([T5_protein_molecule], [T5_mod_protein_molecule])

        CUSTOM_PROCESS([T6_plasmid_molecule, S1_molecule], [T6_protein_molecule, T6_plasmid_molecule])

        CUSTOM_PROCESS([T4_plasmid_strand_molecule], [T4_plasmid_molecule], INHIBITORS: T4_plasmid_molecule)
        CUSTOM_PROCESS([T5_plasmid_strand_molecule], [T5_plasmid_molecule], INHIBITORS: T5_plasmid_molecule)
        CUSTOM_PROCESS([T6_plasmid_strand_molecule], [T6_plasmid_molecule], INHIBITORS: T6_plasmid_molecule)


        DEGRADATION(T0_protein_molecule)
        DEGRADATION(T1_protein_molecule)
        DEGRADATION(T2_protein_molecule)
        DEGRADATION(T3_protein_molecule)
        DEGRADATION(T4_protein_molecule)
        DEGRADATION(T5_protein_molecule)
        DEGRADATION(T6_protein_molecule)
        DEGRADATION(T0_mod_protein_molecule)
        DEGRADATION(T1_mod_protein_molecule)
        DEGRADATION(T2_mod_protein_molecule)
        DEGRADATION(T3_mod_protein_molecule)
        DEGRADATION(T4_mod_protein_molecule)
        DEGRADATION(T5_mod_protein_molecule)
        DEGRADATION(T6_mod_protein_molecule)
        DEGRADATION(S1_molecule)
        DEGRADATION(S2_molecule)
        DEGRADATION(T4_plasmid_strand_molecule)
        DEGRADATION(T5_plasmid_strand_molecule)
        DEGRADATION(T6_plasmid_strand_molecule)

